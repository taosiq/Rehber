DATABASE_URL=postgresql+asyncpg://rehber:rehber@127.0.0.1:5432/rehber
REDIS_URL=redis://127.0.0.1:6379/0

# Chat AI provider: "groq" (free, no card). Others can be added later.
LLM_PROVIDER=groq

# Optional: Google Gemini (needs billing on some accounts)
GEMINI_API_KEY=

# Optional, only if you switch LLM_PROVIDER=anthropic later
ANTHROPIC_API_KEY=

# Free chat AI key from https://console.groq.com (Phase 3)
GROQ_API_KEY=

# Long random value (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Production only:
# ENVIRONMENT=production
# COOKIE_SECURE=true

# Optional: Langfuse tracing (free account at https://cloud.langfuse.com) (Phase 7)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Production (docker compose --profile prod sets most of these for you) ---
# ENVIRONMENT=production
# COOKIE_SECURE=true
# TRUST_PROXY=true
# PUBLIC_URL=https://your-pc.your-tailnet.ts.net

# Email (Phase 9). "console" just logs emails. For real emails create a free Brevo account,
# verify your sender address, and create an API key (SMTP & API -> API keys).
EMAIL_PROVIDER=console
BREVO_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Rehber
